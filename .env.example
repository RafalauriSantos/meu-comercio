# ==============================================================================
# Meu Comércio — Environment variables (.env.example)
# ==============================================================================
# Local development:
#   cp .env.example .env.local
#
# On Vercel, add these variables in the project settings (Environment Variables).
# NEVER commit .env or .env.local files that contain real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database — Neon (PostgreSQL serverless)
# ------------------------------------------------------------------------------
# Use the direct connection string from the Neon console (Connection Details).
# The driver @neondatabase/serverless works with sslmode=require.
DATABASE_URL="postgresql://usuario_neon:senha_neon@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Session signing
# ------------------------------------------------------------------------------
# High-entropy secret (at least 32 characters) used to sign session cookies.
# Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="gere-uma-chave-aleatoria-longa-com-pelo-menos-32-caracteres"

# ------------------------------------------------------------------------------
# 3. Error tracking — Sentry (optional)
# ------------------------------------------------------------------------------
# Public DSN of the Sentry project. Leave empty and Sentry stays off and silent.
# It is embedded in the browser JS at BUILD time, so set it before the build.
NEXT_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 4. E-mail — Brevo (account recovery, D-32)
# ------------------------------------------------------------------------------
# API key of the Brevo account (Brevo > SMTP & API > API keys). Secret: only here and in Vercel.
BREVO_API_KEY=
# Sender address verified in Brevo (a single verified sender; no own domain).
BREVO_SENDER_EMAIL=
# Display name of the sender. Optional: when empty, the default is "Meu Comércio".
BREVO_SENDER_NAME=
# Public base URL of the app, used in the links of the e-mails (never taken from the Host header).
# Example: https://seu-app.vercel.app (no trailing slash).
APP_BASE_URL=
