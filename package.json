{
  "name": "meu-comercio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"if (process.env.DATABASE_URL) { console.log('Applying database schema to Neon...'); require('child_process').execSync('npx drizzle-kit push --force', { stdio: 'inherit' }); }\" && next build",
    "db:push": "drizzle-kit push --force",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
