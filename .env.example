# ==============================================================================
# Meu Comércio — Environment variables (.env.example)
# ==============================================================================
# Local development:
#   cp .env.example .env.local
#
# On Vercel, add these variables in the project settings (Environment Variables).
# NEVER commit .env or .env.local files that contain real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database — Neon (PostgreSQL serverless)
# ------------------------------------------------------------------------------
# Use the direct connection string from the Neon console (Connection Details).
# The driver @neondatabase/serverless works with sslmode=require.
DATABASE_URL="postgresql://usuario_neon:senha_neon@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Session signing
# ------------------------------------------------------------------------------
# High-entropy secret (at least 32 characters) used to sign session cookies.
# Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="gere-uma-chave-aleatoria-longa-com-pelo-menos-32-caracteres"
